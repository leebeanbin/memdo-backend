{
  "name": "memdo-backend",
  "private": true,
  "scripts": {
    "start": "supabase start",
    "stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "functions:serve": "supabase functions serve",
    "functions:deploy": "supabase functions deploy --use-api",
    "check": "deno check --node-modules-dir=manual supabase/functions/*/index.ts && deno fmt --check",
    "test": "deno test --node-modules-dir=manual supabase/functions/_shared eval",
    "eval": "deno run --allow-net --allow-read --allow-env --allow-write eval/run.ts",
    "eval:seed": "deno run --allow-net --allow-env eval/seed.ts",
    "eval:compare": "deno run --allow-net --allow-read --allow-env --allow-write eval/compare.ts",
    "eval:promote-registry": "deno run --allow-read eval/promote-registry.ts"
  },
  "devDependencies": {
    "deno": "^2.9.4",
    "supabase": "2.110.0"
  },
  "dependencies": {
    "@supabase/server": "^1.4.1",
    "zod": "^4.4.3"
  }
}
